# Generate unique local keys with scripts/prepare-local.py; never commit .env.
FINNOVA_DATABASE_URL=postgresql+psycopg://finnova:CHANGE_ME@127.0.0.1:5432/finnova
FINNOVA_JWT_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES
FINNOVA_DATA_KEY=GENERATE_A_FERNET_KEY
FINNOVA_PUBLIC_ORIGIN=https://localhost:8443
# HTTPS endpoint of the transactional-email dispatcher. Required to deliver confirmations.
# FINNOVA_EMAIL_WEBHOOK_URL=https://mail-dispatcher.example/send
# First administrator bootstrap: this address receives the role only after email confirmation.
# FINNOVA_INITIAL_ADMIN_EMAIL=admin@example.com
# ADR-009: daily BCB/Tesouro sync at 07:00 and weekly CVM sync (America/Sao_Paulo).
# FINNOVA_OFFICIAL_SOURCES_SYNC=true
# RNF-13: reverse proxies (IPs/CIDR, comma-separated) whose X-Forwarded-For identifies the client.
# FINNOVA_TRUSTED_PROXIES=10.0.0.0/8
# RNF-04: concurrent requests admitted per process; the rest wait up to the queue timeout (503 after).
# Keep it below DB_POOL_SIZE + DB_MAX_OVERFLOW and at most 35.
# FINNOVA_MAX_CONCURRENT_REQUESTS=30
# FINNOVA_QUEUE_TIMEOUT_SECONDS=10
# FINNOVA_DB_POOL_SIZE=20
# FINNOVA_DB_MAX_OVERFLOW=20
# FINNOVA_DB_POOL_TIMEOUT_SECONDS=10
# Startup waits for the database (fail-closed: no request is served before the deletion replay).
# FINNOVA_STARTUP_ATTEMPTS=10
# FINNOVA_STARTUP_RETRY_SECONDS=3
