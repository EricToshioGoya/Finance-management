# Generate unique local keys with scripts/prepare-local.py; never commit .env.
FINNOVA_DATABASE_URL=postgresql+psycopg://finnova:CHANGE_ME@127.0.0.1:5432/finnova
FINNOVA_JWT_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES
FINNOVA_DATA_KEY=GENERATE_A_FERNET_KEY
FINNOVA_PUBLIC_ORIGIN=https://localhost:8443
